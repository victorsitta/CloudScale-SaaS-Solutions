# Provedor de LLM ativo: "groq" ou "cohere"
LLM_PROVIDER=groq

# Chave de API da Groq (obrigatória se LLM_PROVIDER=groq)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Chave de API da Cohere (obrigatória se LLM_PROVIDER=cohere)
COHERE_API_KEY=...
COHERE_MODEL=command-a-03-2025

# Configurações do RAG (opcionais)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Senha para desbloquear ações administrativas na UI (trocar chave, reindexar, upload)
ADMIN_PASSWORD=troque-esta-senha
